# Required: Your Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Specific Discord Guild / Server ID
GUILD_ID=your_guild_id_here

# Kinetic Hosting REST API Configuration
PORT=3000
BOT_API_SECRET=your_super_secret_bearer_token

# Commission Bot Channels & Permissions
COMMISSION_CATEGORY_ID=your_commissions_category_id
STAFF_ROLE_ID=your_staff_role_id

# Storage Paths
CONFIG_PATH=./config.json
DATA_PATH=./data/stats.json
TICKETS_DB_PATH=./data/tickets.db
TAGS_PATH=./tags

# GitHub Issues for Forum Posts (fine-grained PAT with Issues read/write)
GITHUB_TOKEN=your_github_token

# Logistics Network library API (defaults to production)
LNET_BASE_URL=https://logistics-network.almanax21.com

# Minecraft crash alerts via Kinetic Panel API (key, server identifier, alert channel)
KINETIC_API_KEY=your_kinetic_api_key
KINETIC_SERVER_ID=your_server_identifier
CRASH_CHANNEL_ID=your_crash_alert_channel_id
KINETIC_PANEL_URL=https://kineticpanel.net
