# Required: Your Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Fast-reload commands for a specific test guild (omit for global)
# GUILD_ID=your_guild_id_here

# Optional: Custom paths (defaults to ./config.json and ./data/stats.json)
# CONFIG_PATH=./config.json
# DATA_PATH=./data/stats.json
